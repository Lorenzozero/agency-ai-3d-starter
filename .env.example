# =====================================================================
# Agency AI 3D — Multi-Agent System Configuration (.env.example)
# Copy to .env and set permissions: cp .env.example .env && chmod 600 .env
# =====================================================================

# --- 1. Backend Mode ('router' = local multi-provider pool | 'anthropic' = direct API key) ---
HLAB_BACKEND=router
ANTHROPIC_API_KEY=

# --- 2. Free / Multi-Provider Router Keys (see models.yaml) ---
OPENROUTER_API_KEY=
GEMINI_FREE_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
GITHUB_MODELS_TOKEN=
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- 3. Web Console & Public Tunnel ---
HLAB_PUBLIC_URL=https://agency-ai.example.com
HLAB_TRUST_CF_IP=0

# --- 4. Budget & Safety Limits ---
HLAB_RUN_BUDGET_USD=0.35
HLAB_DAILY_BUDGET_USD=3.00

# --- 5. Optional: Telegram Bot Notifications & 1-Click Approvals ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 6. Optional: External CRM Database (PostgreSQL / Neon read-only) ---
CRM_DATABASE_URL=
