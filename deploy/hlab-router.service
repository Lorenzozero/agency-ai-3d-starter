[Unit]
Description=hlab router (Anthropic -> OpenRouter, pool di modelli a rotazione)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/hermes_lab
Environment=HLAB_HOME=/home/ubuntu/hermes_lab
EnvironmentFile=/home/ubuntu/hermes_lab/.env
ExecStart=/home/ubuntu/hermes_lab/venv/bin/python -m hlab router
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/hermes_lab/data
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
